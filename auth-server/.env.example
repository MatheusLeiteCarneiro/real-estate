# =========================================================
# Real Estate Authorization Server
# =========================================================

# =========================================================
# Shared with other modules — keep these in sync manually
# =========================================================
# This module doesn't read the root .env or any other module's .env.
# These values must match the same variables in api/.env (and, for
# POSTGRES_*/REDIS_*, the root .env used by docker-compose.yml).

SPRING_PROFILES_ACTIVE=dev

# Must match the root .env (docker-compose.yml's own database service).
POSTGRES_DB=realestate_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Must match the root .env (docker-compose.yml's own redis service)
# and bff/.env (both connect to the same Redis instance).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# Public issuer expected in the tokens' "iss" claim.
# Must match the same variable in api/.env.
AUTHORIZATION_SERVER_URL=http://localhost:9000

# OAuth2 client ID used by Swagger UI (springdoc).
# Must match the same variable in api/.env.
SWAGGER_CLIENT_ID=swagger-client

# =========================================================
# Auth-server-specific
# =========================================================

# Confidential OAuth2 client used by the BFF.
BFF_CLIENT_ID=real-estate-bff
BFF_CLIENT_SECRET=change-me
BFF_REDIRECT_URI=http://localhost:8081/login/oauth2/code/real-estate-bff
BFF_POST_LOGOUT_REDIRECT_URI=http://localhost:3000

# RSA signing keys.
# Paths are relative to the auth-server module working directory.
JWT_PUBLIC_KEY=file:./secrets/app.pub
JWT_PRIVATE_KEY=file:./secrets/app.key

# Token lifetime in seconds.
JWT_ACCESS_TOKEN_DURATION=8000
JWT_REFRESH_TOKEN_DURATION=604800

# Redirect URI used by the development Swagger OAuth2 client.
SWAGGER_REDIRECT_URI=http://localhost:8080/swagger-ui/oauth2-redirect.html

# Origin allowed via CORS on /oauth2/token (dev profile only), so Swagger UI's
# browser-side PKCE token exchange can complete. Swagger UI is served by the API,
# so this is the API's own public URL, not the auth-server's.
SWAGGER_UI_ORIGIN=http://localhost:8080

# Development-only OAuth2 client used by Postman.
# This client is available only when the dev profile is active.
POSTMAN_CLIENT_ID=postman-client
POSTMAN_CLIENT_SECRET=postman-secret
POSTMAN_REDIRECT_URI=https://oauth.pstmn.io/v1/browser-callback
