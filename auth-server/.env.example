# =========================================================
# Real Estate Authorization Server
# =========================================================

# Confidential OAuth2 client used by the BFF.
BFF_CLIENT_ID=real-estate-bff
BFF_CLIENT_SECRET=change-me
BFF_REDIRECT_URI=http://localhost:8081/login/oauth2/code/real-estate-bff
BFF_POST_LOGOUT_REDIRECT_URI=http://localhost:3000

# RSA signing keys.
# Paths are relative to the auth-server module working directory.
JWT_PUBLIC_KEY=file:./secrets/app.pub
JWT_PRIVATE_KEY=file:./secrets/app.key

# Token lifetime in seconds.
JWT_ACCESS_TOKEN_DURATION=8000
JWT_REFRESH_TOKEN_DURATION=604800

# Redirect URI used by the development Swagger OAuth2 client.
SWAGGER_REDIRECT_URI=http://localhost:8080/swagger-ui/oauth2-redirect.html

# Development-only OAuth2 client used by Postman.
# This client is available only when the dev profile is active.
POSTMAN_CLIENT_ID=postman-client
POSTMAN_CLIENT_SECRET=postman-secret
POSTMAN_REDIRECT_URI=https://oauth.pstmn.io/v1/browser-callback
