<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"
         child.project.url.inherit.append.path="false">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.6</version>
        <relativePath/>
    </parent>

    <groupId>com.mlcdev</groupId>
    <artifactId>real-estate</artifactId>
    <version>2.0.0</version>
    <packaging>pom</packaging>
    <name>Real Estate</name>
    <description>Monorepo for the Real Estate API, Authorization Server, BFF, and future web application.</description>
    <url>https://github.com/MatheusLeiteCarneiro/real-estate</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>MatheusLeiteCarneiro</id>
            <name>Matheus Leite Carneiro</name>
            <url>https://github.com/MatheusLeiteCarneiro</url>
            <roles>
                <role>Developer</role>
            </roles>
        </developer>
    </developers>
    <scm child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false"
         child.scm.url.inherit.append.path="false">
        <connection>scm:git:https://github.com/MatheusLeiteCarneiro/real-estate.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/MatheusLeiteCarneiro/real-estate.git</developerConnection>
        <tag>HEAD</tag>
        <url>https://github.com/MatheusLeiteCarneiro/real-estate</url>
    </scm>

    <properties>
        <java.version>25</java.version>
        <commons-lang3.version>3.20.0</commons-lang3.version>
    </properties>

    <modules>
        <module>migrations</module>
        <module>api</module>
        <module>auth-server</module>
        <module>bff</module>
    </modules>
</project>
