# =========================================================
# Real Estate BFF
# =========================================================

# =========================================================
# Shared with other modules — keep these in sync manually
# =========================================================
# This module doesn't read the root .env or any other module's .env.
# These values must match the same variables in auth-server/.env (both
# connect to the same Redis instance) and the root .env used by
# docker-compose.yml.

SPRING_PROFILES_ACTIVE=dev

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# =========================================================
# BFF-specific
# =========================================================

# Confidential OAuth2 client used by the BFF.
# CLIENT_ID and CLIENT_SECRET must match the values in auth-server/.env.
BFF_CLIENT_ID=real-estate-bff
BFF_CLIENT_SECRET=change-me
BFF_REDIRECT_URI=http://localhost:8081/login/oauth2/code/real-estate-bff

# Authorization Server endpoints.
# AUTH_URI and LOGOUT_URI are opened by the user's browser (the BFF redirects the browser
# to them), so they must be the public URL of the authorization server, reachable from
# the user's machine. In local development that is localhost; in production, its public address.
AUTH_URI=http://localhost:9000/oauth2/authorize
LOGOUT_URI=http://localhost:9000/connect/logout

# TOKEN_URI and JWK_SET_URI are called by the BFF itself (server to server), so they must be
# reachable from the BFF process. Under Docker Compose, override them with the auth-server
# service name; when running apart, use whatever address the BFF can reach.
TOKEN_URI=http://localhost:9000/oauth2/token
JWK_SET_URI=http://localhost:9000/oauth2/jwks

# URL to the frontend
FRONTEND_URL=http://localhost:3000
# URL to the API
API_URL=http://localhost:8080

# Time to an inactive session close
SESSION_TIMEOUT=3d
# Max time a cookie can live - after this time the user has to do the login again
SESSION_COOKIE_MAX_AGE=7d
