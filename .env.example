# =========================================================
# docker-compose.yml only
# =========================================================
# Docker Compose reads this file itself to resolve the ${VAR} placeholders
# in docker-compose.yml — this is not read by any Spring Boot module.
# It only exists because the `database` and `redis` services aren't owned
# by any single module and have nowhere else to get these values from.
#
# Each module's own .env.example documents everything that module needs,
# including its own copy of shared values like POSTGRES_* and REDIS_*.
# Keep those copies in sync manually when you change a value here.

# Local development: dev
# Production/deploy: prod
SPRING_PROFILES_ACTIVE=dev

POSTGRES_DB=realestate_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me

REDIS_PASSWORD=change-me
