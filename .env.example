# =========================================================
# Shared configuration
# =========================================================
# Used by the API and Authorization Server.

# Local development: dev
# Production/deploy: prod
SPRING_PROFILES_ACTIVE=dev

# =========================================================
# PostgreSQL
# =========================================================
POSTGRES_DB=realestate_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me

# Use localhost when running the applications directly.
# Docker Compose overrides DB_HOST with the database service name.
DB_HOST=localhost
DB_PORT=5432

# =========================================================
# Authorization Server issuer
# =========================================================
# Public issuer expected in the tokens' "iss" claim.
# The API and Authorization Server must use exactly the same value.
AUTHORIZATION_SERVER_URL=http://localhost:9000

# =========================================================
# Development Swagger OAuth2 client
# =========================================================
# Shared by the API's Swagger UI and the Authorization Server.
SWAGGER_CLIENT_ID=swagger-client
