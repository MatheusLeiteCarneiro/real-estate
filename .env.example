# =========================================================
# Application profile
# =========================================================
# Local development: dev
# Production/deploy: prod
SPRING_PROFILES_ACTIVE=dev

# =========================================================
# Cloudinary
# =========================================================
# Replace with your own Cloudinary URL:
CLOUDINARY_URL=cloudinary://your-api-key:your-api-secret@your-cloud-name

# Folder where property images will be uploaded
PROPERTY_IMAGE_FOLDER=uploadFolder

# =========================================================
# Upload limits
# =========================================================
# Maximum size for each uploaded file.
# Cloudinary Free plan has a 10MB upload limit per image.
# Keep this value compatible with your Cloudinary account limits.
MAX_FILE_SIZE=10MB

# Maximum size for the entire multipart request.
MAX_REQUEST_SIZE=100MB

# =========================================================
# PostgreSQL
# =========================================================
# Local database name, user and password
POSTGRES_DB=realestate_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me

# Use localhost when running the app directly on your machine.
# Docker Compose overrides DB_HOST to "database" for the API container.
DB_HOST=localhost
DB_PORT=5432

# =========================================================
# Admin user
# =========================================================
# Initial admin user created by the application
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# =========================================================
# Security / JWT
# =========================================================
# Local application URL.
# In production, replace with your deployed API URL.
AUTHORIZATION_SERVER_URL=http://localhost:8080

# Duration in seconds
JWT_REFRESH_TOKEN_DURATION=604800
JWT_ACCESS_TOKEN_DURATION=8000

# =========================================================
# OAuth2 clients - Postman
# =========================================================
# These values can usually stay as they are for local testing with Postman.
POSTMAN_CLIENT_ID=postman-client
POSTMAN_CLIENT_SECRET=postman-secret
POSTMAN_REDIRECT_URI=https://oauth.pstmn.io/v1/browser-callback

# =========================================================
# OAuth2 clients - Swagger UI
# =========================================================
# Local Swagger OAuth2 redirect URI.
# In production, replace localhost with your deployed API URL.
SWAGGER_CLIENT_ID=swagger-client
SWAGGER_REDIRECT_URI=http://localhost:8080/swagger-ui/oauth2-redirect.html

# =========================================================
# OAuth2 clients - SPA frontend
# =========================================================
# Replace these when you have a frontend application.
SPA_CLIENT_ID=spa-client
SPA_REDIRECT_URI=http://localhost:5173/oauth2/callback

# =========================================================
# CORS
# =========================================================
# Allowed frontend origins separated by commas.
# In production, include your deployed frontend URL.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# =========================================================
# RSA keys for JWT
# =========================================================
# Generate local keys with:
# mkdir -p secrets
# openssl genrsa -out secrets/app.key 2048
# openssl rsa -in secrets/app.key -pubout -out secrets/app.pub
#
# Do not commit real keys.
# These values are optional because application.properties already has fallbacks.
# JWT_PUBLIC_KEY=file:./secrets/app.pub
# JWT_PRIVATE_KEY=file:./secrets/app.key
