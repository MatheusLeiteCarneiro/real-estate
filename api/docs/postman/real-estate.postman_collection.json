        "type": "string"
      },
      {
        "key": "grant_type",
        "value": "authorization_code_with_pkce",
        "type": "string"
      },
      {
        "key": "authUrl",
        "value": "{{authorizationServerUrl}}/oauth2/authorize",
        "type": "string"
      },
      {
        "key": "accessTokenUrl",
        "value": "{{authorizationServerUrl}}/oauth2/token",
        "type": "string"
      },
      {
        "key": "refreshTokenUrl",
        "value": "{{authorizationServerUrl}}/oauth2/token",
        "type": "string"
      },
      {
        "key": "redirect_uri",
        "value": "{{postmanRedirectUri}}",
        "type": "string"
      },
      {
        "key": "clientId",
        "value": "{{postmanClientId}}",
        "type": "string"
      },
      {
        "key": "clientSecret",
        "value": "{{postmanClientSecret}}",
        "type": "string"
      },
      {
        "key": "scope",
        "value": "{{oauthScope}}",
        "type": "string"
      },
      {
        "key": "client_authentication",
        "value": "header",
        "type": "string"
      },
      {
        "key": "usePkce",
        "value": true,
        "type": "boolean"
      },
      {
        "key": "challengeAlgorithm",
