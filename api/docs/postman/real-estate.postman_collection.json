{
  "info": {
    "_postman_id": "7a7d3924-2115-4f9b-9bb5-04952a7379f1",
    "name": "Real Estate API",
    "description": "Postman collection for the Real Estate Spring Boot API. Protected requests inherit OAuth2 Authorization Code with PKCE from the collection Authorization tab. Import the Real Estate - API environment and use Get New Access Token with client_id {{postmanClientId}}, client_secret {{postmanClientSecret}}, callback {{postmanRedirectUri}}, scope {{oauthScope}}, auth URL {{authorizationServerUrl}}/oauth2/authorize and token URL {{authorizationServerUrl}}/oauth2/token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "oauth2",
    "oauth2": [
      {
        "key": "tokenName",
        "value": "RealEstate Token",
        "type": "string"
      },
      {
        "key": "accessToken",
        "value": "{{accessToken}}",
        "type": "string"
      },
      {
        "key": "headerPrefix",
        "value": "Bearer",
        "type": "string"
      },
      {
        "key": "addTokenTo",
