# Initial administrator created by the API.
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Cloudinary storage.
CLOUDINARY_URL=cloudinary://your-api-key:your-api-secret@your-cloud-name
PROPERTY_IMAGE_FOLDER=propertiesFolder

# Maximum size of one file and of the complete multipart request.
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=100MB
