# =========================================================
# Real Estate API
# =========================================================

# =========================================================
# Shared with other modules — keep these in sync manually
# =========================================================
# This module doesn't read the root .env or any other module's .env.
# These values must match the same variables in auth-server/.env
# (and, for POSTGRES_*, the root .env used by docker-compose.yml).

SPRING_PROFILES_ACTIVE=dev

# Must match the root .env (docker-compose.yml's own database service).
POSTGRES_DB=realestate_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Public issuer expected in the tokens' "iss" claim.
# Must match the same variable in auth-server/.env.
AUTHORIZATION_SERVER_URL=http://localhost:9000

# Where the JWT resource server fetches signing keys from.
JWK_SET_URI=http://localhost:9000/oauth2/jwks

# OAuth2 client ID used by Swagger UI (springdoc).
# Must match the same variable in auth-server/.env.
SWAGGER_CLIENT_ID=swagger-client

# =========================================================
# API-specific
# =========================================================

# Initial administrator created by the API.
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Cloudinary storage.
CLOUDINARY_URL=cloudinary://your-api-key:your-api-secret@your-cloud-name
PROPERTY_IMAGE_FOLDER=propertiesFolder

# Maximum size of one file and of the complete multipart request.
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=100MB
